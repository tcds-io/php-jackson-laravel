{
  "name": "tcds-io/php-jackson-laravel",
  "description": "A Laravel plugin to inject and respond serializable objects in controllers",
  "type": "library",
  "license": "MIT",
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "laravel/framework": "^12.0.0|^13.0.0",
    "tcds-io/php-jackson": "^1.1.0"
  },
  "require-dev": {
    "symfony/var-dumper": "^7.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.3",
    "php-cs-fixer/shim": "^3.88"
  },
  "autoload": {
    "psr-4": {
      "Tcds\\Io\\Jackson\\Laravel\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\Tcds\\Io\\Jackson\\Laravel\\": "tests/"
    }
  },
  "scripts": {
    "cs:check": "vendor/bin/php-cs-fixer check -v --config=.php-cs-fixer.dist.php",
    "cs:fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
    "test:stan": "vendor/bin/phpstan analyse --ansi --memory-limit=1G",
    "tests": [
      "@cs:check",
      "@test:stan"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Tcds\\Io\\Jackson\\Laravel\\Providers\\JacksonLaravelObjectMapperProvider"
      ]
    }
  }
}
